{
  "version": "reviewer-pilot-v1",
  "_about": "Internal pilot questionnaire. Review questions appear on every website; followup questions appear for two randomly selected websites after all initial ratings are complete. Keep IDs and stored option values stable after collecting data.",
  "questions": [
    {
      "id": "ai_appearance",
      "type": "scale",
      "prompt": "Based on your overall impression, how strongly does this website appear AI-generated?",
      "help": "Rate the impression the website gives you.",
      "min": 1,
      "max": 5,
      "min_label": "Not at all",
      "max_label": "Extremely",
      "required_unless": {
        "question_id": "technical_issue",
        "value": "unable"
      },
      "options": [
        {
          "value": "1",
          "label": "Not at all"
        },
        {
          "value": "2",
          "label": "Slightly"
        },
        {
          "value": "3",
          "label": "Moderately"
        },
        {
          "value": "4",
          "label": "Very"
        },
        {
          "value": "5",
          "label": "Extremely"
        }
      ]
    },
    {
      "id": "seen_before",
      "type": "single",
      "prompt": "Had you seen this website before today?",
      "options": [
        {
          "value": "no",
          "label": "No"
        },
        {
          "value": "yes_seen",
          "label": "Yes, I've seen it"
        },
        {
          "value": "yes_made",
          "label": "Yes, I helped make it"
        },
        {
          "value": "unsure",
          "label": "Unsure"
        }
      ]
    },
    {
      "id": "technical_issue",
      "type": "single",
      "prompt": "Did a technical problem affect your review?",
      "options": [
        {
          "value": "no",
          "label": "No"
        },
        {
          "value": "some",
          "label": "Yes, but I could still evaluate the webpage"
        },
        {
          "value": "unable",
          "label": "I could not evaluate the webpage"
        }
      ],
      "help": "If you could not evaluate it, you may leave the appearance rating blank."
    },
    {
      "id": "annotations",
      "type": "annotation",
      "phase": "followup",
      "prompt": "Point to a detail on this webpage.",
      "help": "Optional. Select an element and add a short note about what influenced your rating.",
      "required": false,
      "max_annotations": 3
    },
    {
      "id": "cues",
      "type": "multi",
      "phase": "followup",
      "prompt": "Which features influenced your judgment?",
      "help": "Select 1–3 cues. Your earlier rating is already saved.",
      "min_selected": 1,
      "max_selected": 3,
      "options": [
        {
          "value": "writing",
          "label": "Wording and writing style"
        },
        {
          "value": "charts",
          "label": "Charts and data presentation"
        },
        {
          "value": "layout",
          "label": "Layout, typography, or colors"
        },
        {
          "value": "images",
          "label": "Images or illustrations"
        },
        {
          "value": "interactions",
          "label": "Interactions or navigation"
        },
        {
          "value": "errors",
          "label": "Errors or inconsistencies"
        },
        {
          "value": "gut_feeling",
          "label": "Gut feeling"
        },
        {
          "value": "other",
          "label": "Other"
        }
      ],
      "required_unless": {
        "question_id": "technical_issue",
        "value": "unable"
      }
    }
  ]
}
