{
  "version": "phd-v1",
  "_about": "Three sections: `background` (once, before the first website), `questions` (asked about every website, in the right-hand panel) and `closing` (once, after the last website). Question ids must be unique across all three. Types: boolean, single, multi, scale, grid, marks (click spots on the website). All questions are required unless \"required\": false. `options` (or a grid's `rows`) may be the name of a list in `option_lists`, so the same feature list is shared everywhere, including the AI-rater prompt. Keep each option's \"value\" stable once data collection starts; it is what gets stored. Labels can be reworded freely.",
  "option_lists": {
    "features": [
      {"value": "color_scheme", "label": "Colors"},
      {"value": "gradients", "label": "Gradients"},
      {"value": "typography", "label": "Fonts"},
      {"value": "emoji_icons", "label": "Emoji/icons"},
      {"value": "buttons", "label": "Buttons and hover effects"},
      {"value": "layout", "label": "Layout and spacing"},
      {"value": "animations", "label": "Animations"},
      {"value": "charts", "label": "Charts"},
      {"value": "writing", "label": "Writing"},
      {"value": "navigation", "label": "Navigation"}
    ],
    "ai_use_frequency": [
      {"value": "never", "label": "Never"},
      {"value": "monthly", "label": "Monthly"},
      {"value": "weekly", "label": "Weekly"},
      {"value": "daily", "label": "Daily"}
    ]
  },
  "background": [
    {
      "id": "field",
      "type": "single",
      "prompt": "What is your field or PhD program?",
      "options": [
        {"value": "cs", "label": "Computer Science"},
        {"value": "data_science", "label": "Data Science"},
        {"value": "cogsci", "label": "Cognitive Science"},
        {"value": "design_hci", "label": "Design or HCI"},
        {"value": "other", "label": "Other"}
      ]
    },
    {
      "id": "phd_year",
      "type": "single",
      "prompt": "What year of your PhD are you in?",
      "options": [
        {"value": "y1", "label": "1st"},
        {"value": "y2", "label": "2nd"},
        {"value": "y3", "label": "3rd"},
        {"value": "y4", "label": "4th"},
        {"value": "y5plus", "label": "5th or later"}
      ]
    },
    {
      "id": "build_experience",
      "type": "single",
      "prompt": "How much experience do you have building websites or data visualizations?",
      "options": [
        {"value": "none", "label": "None"},
        {"value": "a_little", "label": "A little"},
        {"value": "moderate", "label": "Moderate"},
        {"value": "a_lot", "label": "A lot"}
      ]
    },
    {
      "id": "taught_course",
      "type": "boolean",
      "prompt": "Have you taught or TA'd a course like DSC 106?"
    },
    {
      "id": "ai_use_code",
      "type": "single",
      "prompt": "How often do you use AI tools (ChatGPT, Claude, Copilot, etc.) to write code?",
      "options": "ai_use_frequency"
    },
    {
      "id": "ai_use_design",
      "type": "single",
      "prompt": "How often do you use AI tools for design or writing?",
      "options": "ai_use_frequency"
    },
    {
      "id": "can_tell_pre",
      "type": "scale",
      "prompt": "I can reliably tell whether a website was made with AI.",
      "min": 1,
      "max": 5,
      "min_label": "Strongly disagree",
      "max_label": "Strongly agree"
    },
    {
      "id": "ai_acceptable",
      "type": "scale",
      "prompt": "Using AI to build a course project is acceptable.",
      "min": 1,
      "max": 5,
      "min_label": "Strongly disagree",
      "max_label": "Strongly agree"
    },
    {
      "id": "ai_less_valuable",
      "type": "scale",
      "prompt": "Work made with AI help is less valuable than work made without it.",
      "min": 1,
      "max": 5,
      "min_label": "Strongly disagree",
      "max_label": "Strongly agree"
    }
  ],
  "questions": [
    {
      "id": "ai_marks",
      "type": "marks",
      "prompt": "Click the parts of the website that feel AI-generated.",
      "help": "Press Start marking, then click every spot that feels AI-generated.",
      "none_label": "Nothing on this site feels AI-generated"
    },
    {
      "id": "feature_rating",
      "type": "grid",
      "prompt": "Rate how AI-generated each feature looks.",
      "help": "Choose N/A if the site doesn't have that feature.",
      "rows": "features",
      "min": 0,
      "max": 10,
      "min_label": "Human-made",
      "max_label": "AI-generated",
      "allow_na": true
    },
    {
      "id": "top_ai_feature",
      "type": "single",
      "prompt": "Which feature looks most AI-generated?",
      "options": "features",
      "extra_options": [
        {"value": "none", "label": "None"}
      ]
    },
    {
      "id": "ai_extent",
      "type": "single",
      "prompt": "How much of this site did AI build?",
      "options": [
        {"value": "none", "label": "None"},
        {"value": "a_little", "label": "A little"},
        {"value": "about_half", "label": "About half"},
        {"value": "most", "label": "Most"},
        {"value": "nearly_all", "label": "Nearly all"}
      ]
    },
    {
      "id": "design_generic",
      "type": "scale",
      "prompt": "The design looks template-like.",
      "min": 1,
      "max": 5,
      "min_label": "Disagree",
      "max_label": "Agree"
    },
    {
      "id": "writing_ai",
      "type": "scale",
      "prompt": "The text sounds AI-written.",
      "min": 1,
      "max": 5,
      "min_label": "Disagree",
      "max_label": "Agree"
    },
    {
      "id": "polish",
      "type": "scale",
      "prompt": "How polished is this site?",
      "min": 1,
      "max": 5,
      "min_label": "Rough",
      "max_label": "Polished"
    },
    {
      "id": "quality",
      "type": "scale",
      "prompt": "How good is this project overall?",
      "min": 1,
      "max": 5,
      "min_label": "Poor",
      "max_label": "Excellent"
    },
    {
      "id": "ai_changes_view",
      "type": "single",
      "prompt": "Would AI use change your view of its quality?",
      "options": [
        {"value": "lower", "label": "Lower"},
        {"value": "no_change", "label": "No change"},
        {"value": "higher", "label": "Higher"}
      ]
    },
    {
      "id": "seen_before",
      "type": "single",
      "prompt": "Have you seen this site before?",
      "options": [
        {"value": "no", "label": "No"},
        {"value": "yes_seen", "label": "Yes"},
        {"value": "yes_made", "label": "I helped make it"}
      ]
    }
  ],
  "closing": [
    {
      "id": "can_tell_post",
      "type": "scale",
      "prompt": "I can reliably tell whether a website was made with AI.",
      "min": 1,
      "max": 5,
      "min_label": "Strongly disagree",
      "max_label": "Strongly agree"
    },
    {
      "id": "reliable_signs",
      "type": "multi",
      "prompt": "Overall, which features were the most reliable signs of AI?",
      "help": "Choose up to 3.",
      "options": "features",
      "max_selected": 3
    },
    {
      "id": "difficulty",
      "type": "scale",
      "prompt": "How hard was it to judge these websites?",
      "min": 1,
      "max": 5,
      "min_label": "Very easy",
      "max_label": "Very hard"
    },
    {
      "id": "ai_vs_human",
      "type": "single",
      "prompt": "Do you think an AI could judge \"AI-ness\" better than a person?",
      "options": [
        {"value": "worse", "label": "Worse"},
        {"value": "same", "label": "About the same"},
        {"value": "better", "label": "Better"},
        {"value": "not_sure", "label": "Not sure"}
      ]
    }
  ]
}
